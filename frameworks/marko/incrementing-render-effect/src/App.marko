import { helpers } from "common";

static const test = helpers.incrementingRenderEffect();
static let advancer;

<let/output=(-1)>

<output/el>${output}</output>

// re-runs after every render that changed `output` -- the bench's
// advancer checks the DOM is in sync before scheduling the next update
<script>
  void output;
  advancer?.();
</script>

<lifecycle onMount() {
  test.doit({
    element: el(),
    get: () => output,
    set: (value) => { output = value; },
    setupAdvancer: (fn) => { advancer = fn; },
  });
}>
